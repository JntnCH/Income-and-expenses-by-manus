# Server Configuration
PORT=3000

# Google Service Account Credentials (Required for Google Sheets)
# Option 1: Separate variables
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Option 2: Full JSON string
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Sheets Configuration
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=รายรับ-รายจ่าย
GOOGLE_INVESTMENT_SHEET_NAME=การลงทุน
MONTHLY_SPREADSHEET_ID=
DEBT_SPREADSHEET_ID=

# OCR Provider: tesseract | google | aws | iapp | appman | spaceocr
OCR_PROVIDER=tesseract

# AI & LLM Keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cloud OCR API Keys (Optional depending on OCR_PROVIDER)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
IAPP_API_KEY=
APPMAN_API_KEY=
APPMAN_API_URL=https://api.appman.co.th/ocr/v1
SPACEOCR_API_KEY=

# Telegram Integration (Optional)
TELEGRAM_TOKEN=
MY_TELEGRAM_CHAT_ID=
