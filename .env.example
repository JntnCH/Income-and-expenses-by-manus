# ============================================================
# Server Configuration
# ============================================================
PORT=3000
NODE_ENV=production

# ============================================================
# Google Sheets Configuration
# ============================================================
# Google Service Account credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Spreadsheet IDs (เก็บไว้ที่นี่เพื่อความปลอดภัย)
GOOGLE_SPREADSHEET_ID=your_main_spreadsheet_id
MONTHLY_SPREADSHEET_ID=your_monthly_spreadsheet_id
DEBT_SPREADSHEET_ID=your_debt_spreadsheet_id

# Google Sheet Names
GOOGLE_SHEET_NAME=รายรับ-รายจ่าย
GOOGLE_INVEST_SHEET_NAME=การลงทุน
GOOGLE_SUMMARY_SHEET_NAME=รวมทุกชีต

# ============================================================
# AI Analyst Configuration (Optional)
# ============================================================
OPENAI_API_KEY=your_openai_api_key

# ============================================================
# Dialogflow Configuration
# ============================================================
DIALOGFLOW_PROJECT_ID=your-dialogflow-project-id

# ============================================================
# OCR Provider Selection
# เลือกค่าย OCR: tesseract | aws | iapp | appman | spaceocr
# ============================================================
OCR_PROVIDER=tesseract

# ============================================================
# External OCR API Keys (ตามที่เลือกใช้)
# ============================================================
IAPP_API_KEY=your_iapp_api_key
APPMAN_API_KEY=your_appman_api_key
SPACEOCR_API_KEY=your_spaceocr_api_key
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
