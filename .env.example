# Server
PORT=8080
NODE_ENV=development

# Browser/API security
# Use an unpredictable value; never commit the actual token.
ADMIN_API_TOKEN=
# Comma-separated browser origins. Leave blank when only server-to-server callers are used.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google Sheets and Google Cloud Vision
# Recommended: supply the complete service-account JSON in the deployment secret manager.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=รายรับ-รายจ่าย
GOOGLE_INVESTMENT_SHEET_NAME=การลงทุน
GOOGLE_BOTDASHBOARD_SHEET_NAME=BotDashboard

# OCR and AI
OCR_PROVIDER=tesseract
OPENAI_API_KEY=

# Explicit opt-in for test/google-sheets.e2e.test.js. Use a dedicated test spreadsheet only.
GOOGLE_E2E_ALLOW_WRITE=false
GOOGLE_E2E_TEST_PREFIX=E2E_TEST
