# ============================================================
# Server Configuration
# ============================================================
PORT=3000
NODE_ENV=production

# ============================================================
# Google Sheets Configuration
# ============================================================
# Google Service Account credentials (JSON string หรือ path ไปยังไฟล์)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SHEET_NAME=รายรับ-รายจ่าย
GOOGLE_INVEST_SHEET_NAME=การลงทุน
# Sheet ที่ใช้ IMPORTRANGE รวมข้อมูลจากทุก Sheet ไว้แล้ว (สำหรับเช็คยอดคงเหลือ)
GOOGLE_SUMMARY_SHEET_NAME=รวมทุกชีต

# ============================================================
# Dialogflow Configuration
# ============================================================
DIALOGFLOW_PROJECT_ID=your-dialogflow-project-id

# ============================================================
# OCR Provider Selection
# เลือกค่าย OCR: tesseract | aws | iapp | appman | spaceocr
# ============================================================
OCR_PROVIDER=tesseract

# ============================================================
# AWS Textract Configuration (ใช้เมื่อ OCR_PROVIDER=aws)
# ============================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1

# ============================================================
# iApp Technology OCR (ใช้เมื่อ OCR_PROVIDER=iapp)
# สมัครได้ที่: https://iapp.co.th
# ============================================================
IAPP_API_KEY=your_iapp_api_key

# ============================================================
# APPMAN OCR (ใช้เมื่อ OCR_PROVIDER=appman)
# สมัครได้ที่: https://www.appman.co.th
# ============================================================
APPMAN_API_KEY=your_appman_api_key
APPMAN_API_URL=https://api.appman.co.th/ocr/v1

# ============================================================
# SpaceOCR (ใช้เมื่อ OCR_PROVIDER=spaceocr)
# สมัครได้ที่: https://spaceocr.com
# ============================================================
SPACEOCR_API_KEY=your_spaceocr_api_key
